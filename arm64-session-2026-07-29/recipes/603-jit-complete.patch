+// whether a Class pointer is a GENUINE second class object (real meta-class, real loader, real dex)
+// or a CORRUPT field value that merely happens to be readable. Deliberately defensive: GetDexFile()
+// CHECK-fails on array/primitive/proxy classes and would crash on garbage, so it is only consulted
+// once the meta-class has been confirmed to be java.lang.Class.
+static void WlDumpClassIdentity(const char* tag, ObjPtr<mirror::Class> c)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (c == nullptr) {
+    fprintf(stderr, "[WESTLAKE-ASE-DIAG]   %s: null\n", tag);
+    fflush(stderr);
+    return;
+  }
+  ObjPtr<mirror::Class> meta = c->GetClass();
+  std::string meta_desc = (meta != nullptr) ? mirror::Class::PrettyDescriptor(meta)
+                                            : std::string("<null>");
+  const bool meta_ok = (meta != nullptr && meta_desc == "java.lang.Class");
+  std::string dex_loc = "<skipped>";
+  if (meta_ok && !c->IsArrayClass() && !c->IsPrimitive() && !c->IsProxyClass()) {
+    dex_loc = c->GetDexFile().GetLocation();
+  }
+  fprintf(stderr,
+          "[WESTLAKE-ASE-DIAG]   %s: cls=%p meta=%p(%s) meta_ok=%d loader=%p status=%d "
+          "array=%d primitive=%d proxy=%d dex=%s\n",
+          tag, c.Ptr(), meta.Ptr(), meta_desc.c_str(), meta_ok ? 1 : 0,
+          c->GetClassLoader().Ptr(), static_cast<int>(c->GetStatus()),
+          c->IsArrayClass() ? 1 : 0, c->IsPrimitive() ? 1 : 0, c->IsProxyClass() ? 1 : 0,
+          dex_loc.c_str());
+  fflush(stderr);
+}
